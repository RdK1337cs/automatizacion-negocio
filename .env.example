# Copia este archivo a .env y completá los valores.

# Servidor
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000
DATA_DIR=data
DB_FILE=app.db

# Panel de administración
JWT_SECRET=cambia-esta-secret-por-una-larga
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────
# Sin estos valores el sistema corre en MODO SIMULADO (no envía mensajes reales).
# Creá la app en: https://developers.facebook.com/apps -> Producto WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cambia_este_token
WHATSAPP_WEBHOOK_APP_SECRET=
# Por defecto se responde dentro de la ventana de 24h (mensajes de clientes).
# Fuera de la ventana se usa el template abajo (debe existir y estar aprobado en Meta).
WHATSAPP_DEFAULT_TEMPLATE=respuesta_general
WHATSAPP_API_VERSION=v21.0

# ── Email transaccional ──────────────────────────────────────────────────
# Deja RESEND_API_KEY vacío para correr en modo simulación (los correos se
# registran en el panel pero no se envían).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Mi Negocio <onboarding@resend.dev>